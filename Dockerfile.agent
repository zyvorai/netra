# syntax=docker/dockerfile:1
FROM golang:1.24-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends clang llvm make libbpf-dev linux-libc-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN make bpf \
 && CGO_ENABLED=0 go build -o /out/netra-agent ./cmd/netra-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/netra-agent /usr/local/bin/netra-agent
COPY --from=build /src/bpf/netra_tc.o /opt/netra/bpf/netra_tc.o
ENTRYPOINT ["/usr/local/bin/netra-agent"]
