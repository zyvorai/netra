FROM golang:1.27-bookworm AS go
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/netra-agent ./cmd/netra-agent

# Clang 14 (Debian bookworm) fails on large CT/policy helpers. Ubuntu 24.04 Clang 18
# matches CI; raise compile-time stack estimate so always_inline helpers can optimize.
FROM ubuntu:24.04 AS bpf
RUN apt-get update && apt-get install -y --no-install-recommends clang llvm linux-libc-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY bpf/ ./
RUN clang -target bpfel -O2 -g -Wall -Wextra -Werror \
    -I/usr/include/$(uname -m)-linux-gnu \
    -mllvm -bpf-stack-size=1024 \
    -c netra_tc.c -o /out.o

FROM gcr.io/distroless/static-debian12
COPY --from=go /out/netra-agent /netra-agent
COPY --from=bpf /out.o /opt/netra/bpf/netra_tc.o
ENTRYPOINT ["/netra-agent"]
