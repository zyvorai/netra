# Optional LLM rewrite for POST /api/v1/ai/ask and POST /api/v1/ai/agent
# (controller process). Leave NETRA_AI_API_KEY unset to keep heuristic-only
# briefs. The Python LangGraph companion has its own env file:
# examples/langgraph.env.example.

# NETRA_AI_API_KEY=sk-...
# NETRA_AI_BASE_URL=https://api.openai.com/v1
# NETRA_AI_MODEL=gpt-4o-mini
