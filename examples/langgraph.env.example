# LangGraph companion (python/netra_langgraph) — separate process from netrad.
# Copy to your shell; never commit a real key.

# Controller the graph talks to (same values netractl uses).
NETRA_URL=http://127.0.0.1:8080
# NETRA_API_KEY=

# Optional second-pass rewrite *in the companion process*.
# Leave unset to keep heuristic synthesis. The controller has its own
# NETRA_AI_API_KEY for /api/v1/ai/ask and /api/v1/ai/agent.
# NETRA_LANGGRAPH_API_KEY=
# NETRA_AI_BASE_URL=https://api.openai.com/v1
# NETRA_AI_MODEL=gpt-4o-mini
